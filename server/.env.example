PORT=5000
NODE_ENV=development
JWT_SECRET=yieldrent_secret_key_2026_farmer_security

# Optional: MySQL Database Configuration (XAMPP default)
# If MySQL is not running, the system automatically runs built-in SQLite!
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yieldrent_db

# Optional: OpenWeather API Key (system has realistic agricultural fallback if unconfigured)
OPENWEATHER_API_KEY=
